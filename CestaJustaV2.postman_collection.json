    {
      "name": "Testes de erro",
      "item": [
        {
          "name": "400 - Validação (campos faltando)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Apenas marca\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/produtos/cadastro",
              "host": ["{{base_url}}"],
              "path": ["produtos", "cadastro"]
            },
            "description": "Espera 400 com array errors[] contendo nome e categoriaId obrigatórios (se rodado como ADMIN)."
          }
        },
        {
          "name": "400 - Tentar cadastrar usuário ADMIN",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Hacker\",\n  \"email\": \"hack@hack.com\",\n  \"senha\": \"senha123\",\n  \"tipoUsuario\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/usuarios/cadastro",
              "host": ["{{base_url}}"],
              "path": ["usuarios", "cadastro"]
            },
            "description": "Espera 400 'Não é permitido cadastrar usuário administrador.' — rota pública mas com regra de negócio."
          }
        },
        {
          "name": "400 - Código de barras duplicado",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Arroz Duplicado\",\n  \"codigoBarras\": \"7891234567890\",\n  \"marca\": \"Qualquer\",\n  \"unidadeMedida\": \"5kg\",\n  \"categoriaId\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/produtos/cadastro",
              "host": ["{{base_url}}"],
              "path": ["produtos", "cadastro"]
            },
            "description": "Requer que o produto 'Arroz Branco 5kg' já exista. Espera 400."
          }
        },
        {
          "name": "404 - Produto não encontrado",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/produtos/99999",
              "host": ["{{base_url}}"],
              "path": ["produtos", "99999"]
            },
            "description": "Espera 404 'Produto não encontrado.'"
          }
        },
        {
          "name": "400 - Parâmetro com tipo errado",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/produtos/abc",
              "host": ["{{base_url}}"],
              "path": ["produtos", "abc"]
            },
            "description": "Espera 400 'Parâmetro id com valor inválido.'"
          }
        },
        {
          "name": "400 - Preço em produto inativo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produtoId\": 1,\n  \"mercadoId\": 1,\n  \"valor\": 25.00,\n  \"dataColeta\": \"2026-04-22\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/precos/cadastro",
              "host": ["{{base_url}}"],
              "path": ["precos", "cadastro"]
            },
            "description": "Requer executar 'Inativar produto' antes. Espera 400 'Produto inativo não aceita registro de preço.'"
          }
        },
        {
          "name": "400 - Data de coleta no futuro",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produtoId\": 2,\n  \"mercadoId\": 1,\n  \"valor\": 8.90,\n  \"dataColeta\": \"2099-01-01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/precos/cadastro",
              "host": ["{{base_url}}"],
              "path": ["precos", "cadastro"]
            },
            "description": "Espera 400 com errors[] contendo 'Data de coleta não pode ser futura'."
          }
        },
        {
          "name": "400 - Valor de preço zero",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produtoId\": 2,\n  \"mercadoId\": 1,\n  \"valor\": 0,\n  \"dataColeta\": \"2026-04-20\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/precos/cadastro",
              "host": ["{{base_url}}"],
              "path": ["precos", "cadastro"]
            },
            "description": "Espera 400 com errors[] contendo 'Valor deve ser maior que zero'."
          }
        },
        {
          "name": "403 - Cadastrar produto sem ser ADMIN",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Tentativa\",\n  \"codigoBarras\": \"0000000000000\",\n  \"marca\": \"X\",\n  \"unidadeMedida\": \"1kg\",\n  \"categoriaId\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/produtos/cadastro",
              "host": ["{{base_url}}"],
              "path": ["produtos", "cadastro"]
            },
            "description": "Rode com token de CONSUMIDOR ou COMERCIANTE (faça Login com outro usuário primeiro). Espera 403 'Acesso negado: permissão insuficiente.'"
          }
        },
        {
          "name": "400 - Inativar produto já inativo",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/produtos/1",
              "host": ["{{base_url}}"],
              "path": ["produtos", "1"]
            },
            "description": "Rode Inativar produto duas vezes seguidas. Segunda chamada: 400 'Produto já está inativo.'"
          }
        },
        {
          "name": "400 - Ativar produto já ativo",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/produtos/1/ativar",
              "host": ["{{base_url}}"],
              "path": ["produtos", "1", "ativar"]
            },
            "description": "Rode contra um produto que já está ativo. Espera 400 'Produto já está ativo.'"
          }
        },
        {
          "name": "400 - Associar usuário não-COMERCIANTE",
          "request": {
