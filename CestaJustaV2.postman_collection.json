          }
        },
        {
          "name": "Ativar produto [ADMIN]",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/produtos/1/ativar",
              "host": ["{{base_url}}"],
              "path": ["produtos", "1", "ativar"]
            },
            "description": "Reativa produto inativo. Retorna 200 OK com ProdutoResponseDTO (ativo: true). Se já estiver ativo, 400."
          }
        }
      ]
    },
